# Folder with YOUR documents (pdf, docx, txt, md). Windows example: C:/Users/you/Documents/docs
DOCS_ROOT=./sample_docs
# SQLite (runs, prompt versions) lives here (git-ignored)
DATA_DIR=./data
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md
# Ollama (run `ollama serve`, then `ollama pull llama3.2:3b`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=800
# Model context window; used to decide one-shot vs map-reduce
CONTEXT_TOKENS=4096
# Map-reduce chunk size and overlap (tokens, estimated)
CHUNK_TOKENS=1500
CHUNK_OVERLAP_TOKENS=150
# Extra attempts when the model returns invalid JSON
JSON_MAX_RETRIES=2
# Seconds to wait for Ollama
LLM_TIMEOUT_S=300
# Prompt templates folder (files are the source of truth)
PROMPTS_DIR=./app/prompts
CORS_ORIGINS=http://localhost:5173
